<Window x:Class="Deiussum.PatternMaker.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Deiussum.PatternMaker.WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Import..." Click="ImportImage" />
                <Separator />
                <MenuItem Header="_Exit" Click="ExitApp" />
            </MenuItem>
        </Menu>

        <ScrollViewer HorizontalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl Name="TopRow">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Black" Width="{Binding Item1}" Height="30" BorderThickness="2" Margin="2">
                                <TextBlock Text="{Binding Item2}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl Name="MosaicChartItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Border
                                    BorderBrush="Black"
                                    Background="{Binding Color, Converter={StaticResource IntegerToBrushConverter}}" 
                                    BorderThickness="2" 
                                    Width="50" 
                                    Height="30">
                                    <TextBlock Width="40" Margin="1">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="Row {0}">
                                                <Binding Path="RowNumber" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Items}" >
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Click="MosaicSquareClicked">
                                                <Border Name="MosaicChartRectangle" 
                                                    BorderBrush="Black" 
                                                    Background="{Binding Color, Converter={StaticResource IntegerToBrushConverter}}" 
                                                    BorderThickness="2" 
                                                    Width="30" 
                                                    Height="30">
                                                    <TextBlock Text="{Binding StitchTypeDisplay}"/>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border
                                    BorderBrush="Black"
                                    Background="{Binding Color, Converter={StaticResource IntegerToBrushConverter}}" 
                                    BorderThickness="2" 
                                    Width="50" 
                                    Height="30">
                                    <TextBlock Width="40" Margin="1">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="Row {0}">
                                                <Binding Path="RowNumber" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl Name="BottomRow">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Black" Width="{Binding Item1}" Height="30" BorderThickness="2" Margin="2">
                                <TextBlock Text="{Binding Item2}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
