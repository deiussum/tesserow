<Window x:Class="Deiussum.PatternMaker.WPF.WrittenPatternDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Deiussum.PatternMaker.WPF"
        mc:Ignorable="d"
        Title="Written Pattern" 
        MinHeight="450" 
        MinWidth="800"
>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" Grid.Column="0" Grid.Row="0">
            <TextBlock Name="WrittenPatternText" Text="{Binding Instructions}" Margin="1" />
        </ScrollViewer>
        <Button Name="CloseButton" Click="OnCloseButtonClick" IsDefault="True" Grid.Column="0" Grid.Row="1">Close</Button>
    </Grid>
</Window>